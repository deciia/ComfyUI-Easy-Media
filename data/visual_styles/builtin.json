        { "dimension": "framing", "text_zh": "跟随人物自然取景，不强求完美构图", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "节奏贴现场真实节奏，允许不完美停顿", "requires_cuts": false },
        { "dimension": "staging", "text_zh": "人物按自己的方式站位与动作，不刻意摆位", "requires_cuts": false }
      ]
    },
    {
      "id": "b07",
      "label_zh": "强节奏剪辑",
      "label_en": "Punchy Cutting",
      "category": "自建·拍法",
      "summary_zh": "短镜头切换、动作对接，突出效率与力度",
      "methods": [
        { "dimension": "editing", "text_zh": "用短镜头串联关键动作，切点落在动作进行中", "requires_cuts": true },
        { "dimension": "rhythm", "text_zh": "前紧后松或逐段加速，避免匀速", "requires_cuts": true },
        { "dimension": "framing", "text_zh": "景别在特写与中景之间跳变，形成力度对比", "requires_cuts": true },
        { "dimension": "information", "text_zh": "每个镜头只承载一个信息点", "requires_cuts": true }
      ]
    },
    {
      "id": "b08",
      "label_zh": "层次纵深",
      "label_en": "Depth Layering",
      "category": "自建·拍法",
      "summary_zh": "前景中景背景分层，空间关系清晰",
      "methods": [
        { "dimension": "framing", "text_zh": "前中后景各放一个信息点，保持纵深可读", "requires_cuts": false },
        { "dimension": "camera", "text_zh": "机位略微偏离正面对齐，让纵深线自然汇聚", "requires_cuts": false },
        { "dimension": "staging", "text_zh": "人物在纵深方向上移动而非仅横向走位", "requires_cuts": false },
        { "dimension": "information", "text_zh": "通过谁在前谁在后交代关系，而非靠台词解释", "requires_cuts": false }
      ]
    }
