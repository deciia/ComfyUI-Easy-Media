  "creators": [
    {
      "id": "b01",
      "label_zh": "静观长镜",
      "label_en": "Contemplative Long Take",
      "category": "自建·拍法",
      "summary_zh": "固定或极缓移动，人物在画面内完成动作",
      "methods": [
        { "dimension": "camera", "text_zh": "机位基本固定，必要时极缓横移，不做快速推拉", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "让一个动作在单个镜头内自然完成，保留呼吸与停顿", "requires_cuts": false },
        { "dimension": "framing", "text_zh": "中景或全景为主，保留环境信息与人物全身关系", "requires_cuts": false },
        { "dimension": "information", "text_zh": "先给环境与位置，再让观众从动作里读出信息", "requires_cuts": false }
      ]
    },
    {
      "id": "b02",
      "label_zh": "紧贴跟拍",
      "label_en": "Close Follow",
      "category": "自建·拍法",
      "summary_zh": "贴身跟随主体移动，景别偏紧，代入感强",
      "methods": [
        { "dimension": "camera", "text_zh": "镜头紧贴主体同行，跟随其速度与方向，避免突然转向", "requires_cuts": false },
        { "dimension": "framing", "text_zh": "近景或中近景，主体占画面较大比例", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "节奏跟随动作推进，不额外切镜打断", "requires_cuts": false },
        { "dimension": "information", "text_zh": "信息由主体动作与手部细节直接给出", "requires_cuts": false }
      ]
    },
    {
      "id": "b03",
      "label_zh": "对称克制",
      "label_en": "Symmetric Restraint",
      "category": "自建·拍法",
      "summary_zh": "正中构图、水平垂直对齐，秩序感强",
      "methods": [
        { "dimension": "framing", "text_zh": "主体置于画面中心，水平线垂直校直，留白对称", "requires_cuts": false },
        { "dimension": "camera", "text_zh": "机位正视、平视，不做倾斜与越轴", "requires_cuts": false },
        { "dimension": "staging", "text_zh": "人物动作控制在画面中轴附近，避免大幅横向走位", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "节奏均匀克制，动作起止清晰", "requires_cuts": false }
      ]
    },
    {
      "id": "b04",
      "label_zh": "悬念受限视角",
      "label_en": "Restricted Reveal",
      "category": "自建·拍法",
      "summary_zh": "先藏信息，靠局部与遮挡制造疑问",
      "methods": [
        { "dimension": "framing", "text_zh": "用门框、前景遮挡或局部取景限制可见范围", "requires_cuts": false },
        { "dimension": "information", "text_zh": "先给结果或局部，再逐步补齐空间关系，不提前揭底", "requires_cuts": false },
        { "dimension": "camera", "text_zh": "机位保持观察者位置，不越到主体身后揭示全貌", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "在关键动作处留停半拍，让观众自己补全", "requires_cuts": false }
      ]
    },
    {
      "id": "b05",
      "label_zh": "产品强调",
      "label_en": "Product Emphasis",
      "category": "自建·拍法",
      "summary_zh": "局部特写与稳定运镜，突出材质与做工",
      "methods": [
        { "dimension": "framing", "text_zh": "以产品局部特写为主，边缘干净、构图简洁", "requires_cuts": false },
        { "dimension": "camera", "text_zh": "缓速推近或平移展示细节，避免抖动", "requires_cuts": false },
        { "dimension": "rhythm", "text_zh": "每个卖点一个短暂的停留，节奏均匀", "requires_cuts": false },
        { "dimension": "information", "text_zh": "逐项呈现功能点，不在同一镜头里堆叠过多信息", "requires_cuts": true }
      ]
    },
    {
      "id": "b06",
      "label_zh": "手持纪实",
      "label_en": "Handheld Documentary",
      "category": "自建·拍法",
      "summary_zh": "轻微手持晃动，跟随真实动作，不做精致调度",
      "methods": [
